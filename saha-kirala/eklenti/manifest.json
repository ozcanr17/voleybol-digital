{
  "manifest_version": 3,
  "name": "Saha Kiralama Otomasyonu",
  "version": "1.6.0",
  "description": "spor.istanbul'da seans açılır açılmaz sahayı yakalar. Kimlik bilgisi istemez — açık oturumunuzu kullanır.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://online.spor.istanbul/*"
  ],
  "background": {
    "service_worker": "arka.js"
  },
  "icons": {
    "16": "ikon16.png",
    "32": "ikon32.png",
    "48": "ikon48.png",
    "128": "ikon128.png"
  },
  "action": {
    "default_title": "Saha Kiralama",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "ikon16.png",
      "32": "ikon32.png",
      "48": "ikon48.png",
      "128": "ikon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://online.spor.istanbul/*"
      ],
      "js": [
        "sayfa.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://online.spor.istanbul/*"
      ],
      "js": [
        "icerik.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://voleybol.digital/*",
        "https://www.voleybol.digital/*",
        "https://ozcanr17.github.io/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    }
  ]
}
